# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# Postgres connection (JDBC format). For Neon/managed Postgres, convert the
# postgresql:// URI they give you into jdbc:postgresql://... and move
# user/password into DB_USERNAME/DB_PASSWORD below.
DB_URL=jdbc:postgresql://localhost:5432/pawlingo
DB_USERNAME=pawlingo
DB_PASSWORD=change-me

# HMAC secret used to sign JWTs. Must be a high-entropy random string
# (32+ random bytes). Generate one with: openssl rand -base64 64
JWT_SECRET=

# Optional overrides (defaults shown)
JWT_EXPIRATION_SECONDS=86400
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
